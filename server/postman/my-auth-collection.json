    {
      "name": "Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate a unique email so re-runs don't hit 409 Conflict",
              "const email = `test_${Date.now()}@example.com`;",
              "pm.collectionVariables.set('testEmail', email);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Returns token', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
              "pm.test('Returns user without passwordHash', () => {",
              "  pm.expect(body.user).to.have.keys('id','email','name','role');",
              "  pm.expect(body.user).to.not.have.property('passwordHash');",
              "});",
              "pm.collectionVariables.set('token', body.token);",
              "pm.collectionVariables.set('userId', body.user.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"{{testName}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
