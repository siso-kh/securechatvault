<file path="server/src/services/redactorClient.js">
const REDACTOR_URL = process.env.REDACTOR_URL || 'http://localhost:4000';
const TIMEOUT_MS = 5000;

class RedactorError extends Error {
  constructor(msg, opts) { super(msg, opts); this.name = 'RedactorError'; }
}
class RedactorBlockedError extends RedactorError {
  constructor(detections) { super('Content blocked'); this.name = 'RedactorBlockedError'; this.detections = detections; }
}
class RedactorUnavailableError extends RedactorError {
  constructor(cause) { super('Redactor unavailable', { cause }); this.name = 'RedactorUnavailableError'; }
}
class RedactorBadInputError extends RedactorError {
  constructor(msg) { super(msg); this.name = 'RedactorBadInputError'; }
}
class RedactorInvalidResponseError extends RedactorError {
  constructor(body) { super('Invalid redactor response'); this.name = 'RedactorInvalidResponseError'; this.body = body; }
}

/**
 * Calls the redactor. Throws one of:
 *   RedactorBlockedError          (422 — message contains blocked content)
 *   RedactorUnavailableError      (timeout, network, 5xx)
 *   RedactorBadInputError         (400 — caller bug, never retry)
 *   RedactorInvalidResponseError  (200 with unexpected shape — treat as 500)
 * The caller decides what "fail closed" means per error class.
 */
async function redact(text, rules = undefined) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), TIMEOUT_MS);

  let res;
  try {
    res = await fetch(`${REDACTOR_URL}/redact`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text, rules }),
      signal: controller.signal,
    });
  } catch (err) {
    // AbortError (timeout) or network error (DNS, ECONNREFUSED)
    console.error('[redactor]', err.name, err.message);
    throw new RedactorUnavailableError(err);
  } finally {
    clearTimeout(timeout);
  }

  if (res.status === 422) {
    const body = await res.json().catch(() => ({}));
    throw new RedactorBlockedError(body.detections || []);
  }
  if (res.status === 400) {
    const body = await res.json().catch(() => ({}));
    throw new RedactorBadInputError(body.error || 'Redactor rejected request');
  }
  if (!res.ok) {
    console.error('[redactor] status', res.status);
    throw new RedactorUnavailableError(new Error(`status ${res.status}`));
  }

  const body = await res.json().catch(() => null);
  if (
    !body ||
    typeof body.maskedText !== 'string' ||
    !Array.isArray(body.detections) ||
    typeof body.blocked !== 'boolean'
  ) {
    console.error('[redactor] invalid response shape', Object.keys(body || {}));
    throw new RedactorInvalidResponseError(body);
  }
  return body;
}

module.exports = {
  redact,
  RedactorError,
  RedactorBlockedError,
  RedactorUnavailableError,
  RedactorBadInputError,
  RedactorInvalidResponseError,
};
</file>

<file path="server/src/services/redactorPipeline.js">
const {
  redact,
  RedactorBlockedError,
  RedactorUnavailableError,
  RedactorBadInputError,
  RedactorInvalidResponseError,
} = require('./redactorClient');

class ChatRedactionError extends Error {
  constructor(status, code, message, details = {}) {
    super(message);
    this.name = 'ChatRedactionError';
    this.status = status;
    this.code = code;
    this.details = details;
  }
}

/**
 * Redacts every text part of every message.
 * Returns { maskedMessages, report } on success.
 * Throws ChatRedactionError on:
 *   422 — a message was blocked (err.details.detections explains why)
 *   503 — the redactor is unreachable / timed out (fail closed)
 *   500 — redactor gave a bad response (our bug)
 */
async function redactMessages(messages, { rules } = {}) {
  const maskedMessages = [];
  const detections = [];
  let redactedMessageCount = 0;

  for (let i = 0; i < messages.length; i++) {
    const msg = messages[i];
    if (!msg || typeof msg.content !== 'string' || msg.content.length === 0) {
      maskedMessages.push(msg);
      continue;
    }

    let result;
    try {
      result = await redact(msg.content, rules);
    } catch (err) {
      if (err instanceof RedactorBlockedError) {
        throw new ChatRedactionError(422, 'CONTENT_BLOCKED',
          'Content blocked by policy', {
            message_index: i,
            role: msg.role,
            detections: err.detections,
          });
      }
      if (err instanceof RedactorUnavailableError) {
        throw new ChatRedactionError(503, 'REDACTOR_UNAVAILABLE',
          'Redactor service unavailable — refusing to forward unredacted content', {
            message_index: i,
          });
      }
      if (err instanceof RedactorBadInputError) {
        throw new ChatRedactionError(500, 'REDACTOR_BAD_INPUT',
          'Redactor rejected the request', { message_index: i, cause: err.message });
      }
      if (err instanceof RedactorInvalidResponseError) {
        throw new ChatRedactionError(500, 'REDACTOR_INVALID_RESPONSE',
          'Redactor returned an invalid response', { message_index: i });
      }
      throw new ChatRedactionError(500, 'REDACTOR_ERROR',
        'Redactor failed', { message_index: i, cause: String(err) });
    }

    if (result.detections.length > 0) redactedMessageCount++;
    for (const d of result.detections) {
      detections.push({
        message_index: i,
        role: msg.role,
        ...d,
      });
    }
    maskedMessages.push({ ...msg, content: result.maskedText });
  }

  return {
    maskedMessages,
    report: {
      blocked: false,
      message_count: messages.length,
      redacted_message_count: redactedMessageCount,
      detections,
    },
  };
}

module.exports = { redactMessages, ChatRedactionError };
</file>

<file path="server/src/services/routerClient.js">
const ROUTER_URL = (process.env.GATEWAY_URL || 'http://127.0.0.1:8090').replace(/\/$/, '');
const GATEWAY_KEY = process.env.GATEWAY_KEY;
const TIMEOUT_MS = 120_000; // 2 min — free endpoints can be slow

if (!GATEWAY_KEY) {
  throw new Error('GATEWAY_KEY is required — add it to .env');
}

const ENDPOINT = `${ROUTER_URL}/v1/chat/completions`;

class RouterError extends Error {
  constructor(msg, opts) { super(msg, opts); this.name = 'RouterError'; }
}
class RouterUpstreamError extends RouterError {
  constructor(status, body, headers) {
    super(`upstream ${status}`);
    this.name = 'RouterUpstreamError';
    this.status = status;
    this.body = body;
    this.headers = headers || {};
  }
}
class RouterUnavailableError extends RouterError {
  constructor(cause) { super('router unavailable', { cause }); this.name = 'RouterUnavailableError'; }
}

async function chatCompletion({ model, messages, temperature, max_tokens, extraHeaders = {} }) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);

  let res;
  try {
    res = await fetch(ENDPOINT, {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${GATEWAY_KEY}`,
        'Content-Type': 'application/json',
        ...extraHeaders,
      },
      body: JSON.stringify({ model, messages, temperature, max_tokens }),
      signal: controller.signal,
    });
  } catch (err) {
    console.error('[router]', err.name, err.message);
    throw new RouterUnavailableError(err);
  } finally {
    clearTimeout(timer);
  }

  const routerHeaders = {};
  for (const h of ['x-router-model', 'x-router-task', 'x-router-hops',
                   'x-router-latency-ms', 'x-router-attempts']) {
    const v = res.headers.get(h);
    if (v !== null) routerHeaders[h] = v;
  }

  const raw = await res.text();
  let body;
  try { body = JSON.parse(raw); } catch { body = { raw }; }

  if (!res.ok) throw new RouterUpstreamError(res.status, body, routerHeaders);
  return { body, headers: routerHeaders };
}

module.exports = {
  chatCompletion,
  RouterError,
  RouterUpstreamError,
  RouterUnavailableError,
};
</file>

