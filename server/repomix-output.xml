<file path="src/controllers/authController.js">
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const User = require('../models/User');

const JWT_SECRET = process.env.JWT_SECRET;
const JWT_EXPIRES_IN = process.env.JWT_EXPIRES_IN || '1d';

function signToken(user) {
  return jwt.sign(
    { sub: user._id, role: user.role },   // payload
    JWT_SECRET,
    { expiresIn: JWT_EXPIRES_IN }
  );
}

// Shape what we send back — never include passwordHash
function publicUser(user) {
  return {
    id: user._id,
    email: user.email,
    name: user.name,
    role: user.role,
  };
}

exports.register = async (req, res, next) => {
  try {
    const { email, password, name } = req.body;

    // Check for duplicate email (Mongo unique index -> error code 11000)
    const existing = await User.findOne({ email: email.toLowerCase() });
    if (existing) {
      return res.status(409).json({ error: 'Email already in use' });
    }

    const passwordHash = await bcrypt.hash(password, 10); // 10 = salt rounds
    const user = await User.create({ email, passwordHash, name });

    const token = signToken(user);
    res.status(201).json({ token, user: publicUser(user) });
  } catch (err) {
    next(err); // let the centralized error handler deal with it
  }
};
exports.login = async (req, res, next) => {
  try {
    const { email, password } = req.body;

    const invalid = { error: 'Invalid email or password' };

    const user = await User.findOne({ email: email.toLowerCase() });
    if (!user) return res.status(401).json(invalid);

    if (user.isBanned) {
      return res.status(403).json({ error: 'Account banned' });
    }

    const ok = await bcrypt.compare(password, user.passwordHash);
    if (!ok) return res.status(401).json(invalid);

    const token = signToken(user);
    res.json({ token, user: publicUser(user) });
  } catch (err) {
    next(err);
  }
};
exports.me = async (req, res, next) => {
  try {
    const user = await User.findById(req.user.id).select('-passwordHash');
    if (!user) return res.status(404).json({ error: 'User not found' });
    res.json({ user: publicUser(user) });
  } catch (err) {
    next(err);
  }
};
</file>

<file path="src/controllers/conversationController.js">
const Conversation = require('../models/Conversation');

// POST /api/conversations
exports.create = async (req, res, next) => {
  try {
    const conv = await Conversation.create({
      userId: req.user.id,                 // from the auth middleware — never from the body
      title: req.body.title || 'New conversation',
    });
    res.status(201).json({ conversation: conv });
  } catch (err) {
    next(err);
  }
};

// GET /api/conversations
exports.list = async (req, res, next) => {
  try {
    const conversations = await Conversation.find({ userId: req.user.id })
      .select('title updatedAt createdAt')  // message bodies not needed for the list view
      .sort({ updatedAt: -1 });               // most recent first
    res.json({ conversations });
  } catch (err) {
    next(err);
  }
};

// GET /api/conversations/:id
exports.get = async (req, res, next) => {
  try {
    const conv = await Conversation.findOne({
      _id: req.params.id,
      userId: req.user.id,     // ownership is part of the query itself
    });
    if (!conv) {
      return res.status(404).json({ error: 'Conversation not found' });
    }
    res.json({ conversation: conv });
  } catch (err) {
    next(err);
  }
};

// PUT /api/conversations/:id  (rename)
exports.update = async (req, res, next) => {
  try {
    const conv = await Conversation.findOneAndUpdate(
      { _id: req.params.id, userId: req.user.id },
      { title: req.body.title },
      { new: true, runValidators: true }  // return the updated doc, validate the title
    );
    if (!conv) {
      return res.status(404).json({ error: 'Conversation not found' });
    }
    res.json({ conversation: conv });
  } catch (err) {
    next(err);
  }
};

// DELETE /api/conversations/:id
exports.remove = async (req, res, next) => {
  try {
    const conv = await Conversation.findOneAndDelete({
      _id: req.params.id,
      userId: req.user.id,
    });
    if (!conv) {
      return res.status(404).json({ error: 'Conversation not found' });
    }
    res.json({ deleted: true });
  } catch (err) {
    next(err);
  }
};
