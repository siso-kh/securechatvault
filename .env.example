# Copy this file to `.env` (next to docker-compose.yml) and fill in real values.
# `.env` is gitignored; never commit credentials.

# MongoDB - both required by docker compose.
MONGO_USER=securechat
MONGO_PASSWORD=change-me
# The backend builds mongodb://<MONGO_USER>:<MONGO_PASSWORD>@mongo:27017/...
# so keep the password URL-safe (letters/digits/._~-) or percent-encode it:
#   $ -> %24   # -> %23   @ -> %40   : -> %3A   / -> %2F

# Backend auth - required.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Shared key between the API and the prior-router gateway - required.
# The backend fails at startup without it; the gateway refuses to boot without it.
GATEWAY_KEY=replace-with-a-long-random-string

# LLM provider keys read by prior-router/gateway/catalogues/*.json.
# At least one is needed; a task whose key is unset is skipped at startup.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Admin account created by the one-shot `seed` service on `docker compose up`.
# ADMIN_PASSWORD must be 8+ characters; it is also the /admin/login passcode.
# Leave ADMIN_EMAIL or ADMIN_PASSWORD empty to skip admin creation - the seed
# service still inserts the default redaction policies (chat needs them).
ADMIN_EMAIL=admin@securechat.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
